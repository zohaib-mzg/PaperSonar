# PaperSonar Phase 2 runtime configuration - PLACEHOLDERS ONLY.
# Never put real credentials, private keys, or tokens in Git.
# See docs/phase2/CONFIGURATION_REFERENCE.md for full documentation.

# ---------------------------------------------------------------------------
# Production target (mandatory). Production is fixed to Snowflake.
# Any other value (postgres, sqlite, local, blank) is rejected at startup.
# ---------------------------------------------------------------------------
PAPERSONAR_TARGET=snowflake

# ---------------------------------------------------------------------------
# Snowflake - mandatory for production ingestion (sync/backfill/load).
# In GitHub Actions these come from repository/environment secrets.
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Private key: either PEM content (-----BEGIN PRIVATE KEY-----) or a path to the key file.
SNOWFLAKE_PRIVATE_KEY=
# Only if the key is encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---------------------------------------------------------------------------
# Source identity/politeness settings (not secrets, but never logged).
# ---------------------------------------------------------------------------
OPENALEX_API_KEY=
CROSSREF_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Runtime (non-secret).
# ---------------------------------------------------------------------------
PAPERSONAR_LOG_LEVEL=INFO
PAPERSONAR_SCHEMA_VERSION=1
PAPERSONAR_CORPUS_CONFIG=
# Local development/testing raw storage ONLY; never the sole production raw store.
PAPERSONAR_RAW_DIR=data/raw

# Per-source enablement and limits (defaults shown; see configuration reference).
OPENALEX_ENABLED=true
CROSSREF_ENABLED=true
ARXIV_ENABLED=true
DATACITE_ENABLED=true
ZENODO_ENABLED=true

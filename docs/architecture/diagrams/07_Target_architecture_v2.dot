digraph PaperSonar {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.32", ranksep="0.48", splines=ortho, fontname="Arial", label="PAPERSONAR | RESEARCH & INNOVATION INTELLIGENCE\nTarget architecture v2 — Phase 1 design only", labelloc=t, fontsize=20];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#526777", fillcolor="#F7FAFC", margin="0.14,0.10"];
 edge [color="#64748B", penwidth=1.3, arrowsize=0.7, fontname="Arial", fontsize=8];
 subgraph cluster_sources { label="1. EXTERNAL RESEARCH SOURCES (FREE ACCESS SUBJECT TO TERMS/LIMITS)"; color="#7C9BB5"; style="rounded";
  oa [label="OpenAlex\nWorks • topics • authors • institutions\nReferences / citation counts", fillcolor="#E6F1FA"];
  cr [label="Crossref\nDOI metadata • index-date changes\nAuthors • funding • references", fillcolor="#E6F1FA"];
  ax [label="arXiv\nPreprints • abstracts • categories\nVersion history / OAI-PMH", fillcolor="#E6F1FA"];
  dc [label="DataCite\nDatasets • software • research outputs\nDOIs • related identifiers", fillcolor="#E6F1FA"];
  ze [label="Zenodo\nDatasets • software • reports\nVersions • related outputs", fillcolor="#E6F1FA"];
  {rank=same; oa; cr; ax; dc; ze;}
 }
 subgraph cluster_ingest { label="2. SOURCE-SPECIFIC HARVEST CONTROL"; color="#6EAA9C"; style="rounded";
  sched [label="Independent connector contract per source\nFixed window • cursor/token • overlap • quota\nRetries • watermark • run state", fillcolor="#E5F5EF"];
  state [label="Sync state & manifests\nlast successful watermark • page checkpoint\nrequest params (secrets redacted) • SHA-256", fillcolor="#E5F5EF"];
  {rank=same; sched; state;}
 }
 subgraph cluster_raw { label="3. IMMUTABLE RAW LANDING"; color="#D4A76A"; style="rounded";
  raw [label="Versioned raw JSON/XML pages\nSource IDs • timestamps • response headers\nChecksums • source licence/provenance", fillcolor="#FFF2DF"];
  replay [label="Replay / resume / quarantine queue\nPartial runs never advance watermarks\nNo deletion inferred from missing pages", fillcolor="#FFF2DF"];
  {rank=same; raw; replay;}
 }
 subgraph cluster_quality { label="4. STAGING, NORMALIZATION & IDENTITY RESOLUTION"; color="#9B8AC4"; style="rounded";
  stage [label="Source staging\nType/date/identifier normalization\nRequired-field & duplicate checks", fillcolor="#F0EBFA"];
  identity [label="Identity crosswalk\nSource-native IDs + normalized DOI\nExplicit relations • version grouping", fillcolor="#F0EBFA"];
  quarantine [label="Quarantine & quality evidence\nDOI conflicts • ambiguous matches\nBad records • coverage/missingness", fillcolor="#FCE8E8"];
  {rank=same; stage; identity; quarantine;}
 }
 subgraph cluster_dw { label="5. CANONICAL RESEARCH-OUTPUT WAREHOUSE"; color="#4E9D91"; style="rounded";
  hub [label="Canonical research_output\npublication • preprint • dataset • software\nreport • other research output", fillcolor="#DDF4EF"];
  source_rec [label="source_record + output_version\nSource provenance • version observations\nfield history / payload hash", fillcolor="#DDF4EF"];
  rel [label="output_relationship\ncites • is-version-of • is-preprint-of\nis-dataset-for • is-software-for", fillcolor="#DDF4EF"];
  obs [label="output_observation + dimensions/bridges\nDated citations/access/source state\ntopic • creator • institution • venue • funder", fillcolor="#DDF4EF"];
  {rank=same; hub; source_rec; rel; obs;}
 }
 subgraph cluster_analytics { label="6. ANALYTICS & REPORTING (PHASE 3 — NOT STARTED)"; color="#7C9BB5"; style="rounded";
  mart [label="PaperSonar analytical mart\nTopic growth • citation cohorts • intersections\ncreator/institution participation • artifact links", fillcolor="#E6F1FA"];
  views [label="Reporting views + OLAP SQL\nROLLUP • CUBE • quality/coverage denominators\nEXPLAIN ANALYZE & index evaluation", fillcolor="#E6F1FA"];
  bi [label="Power BI Desktop (local)\nExecutive research overview • detailed analysis\nDecision & evidence page", fillcolor="#E6F1FA"];
  {rank=same; mart; views; bi;}
 }
 subgraph cluster_platform { label="7. PLATFORM STRATEGY"; color="#A0A7B2"; style="rounded,dashed";
  pg [label="REQUIRED: Local PostgreSQL\nZero-cost reproducible reference path", fillcolor="#E9F7E9"];
  snow [label="OPTIONAL: Snowflake trial/education only\nNot permanently free • hard stop before charges\nNever required for evaluation", fillcolor="#FFF7E5"];
  future [label="Future web/API + evidence dossiers\nNot in current implementation", fillcolor="#F3F4F6"];
  {rank=same; pg; snow; future;}
 }
 oa -> sched; cr -> sched; ax -> sched; dc -> sched; ze -> sched;
 sched -> state [dir=both, label="read/write checkpoint"];
 sched -> raw [label="durable page first"];
 raw -> replay; replay -> stage; stage -> identity; stage -> quarantine [style=dashed]; identity -> hub; identity -> source_rec; identity -> rel; hub -> obs; source_rec -> obs; rel -> obs;
 obs -> mart; mart -> views; views -> bi;
 hub -> pg [style=dashed, label="logical DW target"];
 pg -> snow [style=dashed, dir=both, label="portable subset only"];
 bi -> future [style=dashed, label="later productization"];
}